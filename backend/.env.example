# LLM Provider: "groq" | "openai" | "anthropic"
LLM_PROVIDER=groq

# Groq (OpenAI-compatible)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Optional override; default is Groq's OpenAI-compatible endpoint
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Storage
DATA_DIR=../data
# Cap on uploaded CSV size; every analysis step reloads the whole file into an
# in-memory DuckDB, so this is a memory limit as much as a disk one.
MAX_UPLOAD_MB=15

# Server
CORS_ORIGINS=http://localhost:3000
# Pattern for origins that change per deployment, e.g. Vercel previews:
# CORS_ORIGIN_REGEX=https://my-project-[a-z0-9-]+\.vercel\.app
